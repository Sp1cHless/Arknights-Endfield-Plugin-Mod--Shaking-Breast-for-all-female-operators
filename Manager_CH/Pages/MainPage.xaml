<Page x:Class="SecondaryMotion.Manager.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="主界面"
      Loaded="OnLoaded"
      Unloaded="OnUnloaded">

    <Page.Resources>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E4E7EB" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A7A7A" />
        <SolidColorBrush x:Key="SoftFillBrush" Color="#F4F6F8" />

        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <Style x:Key="SectionHintStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,1,0,0" />
        </Style>

        <Style x:Key="AdvancedParamTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#222222" />
        </Style>

        <Style x:Key="AdvancedParamHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,8,0" />
        </Style>

        <Style x:Key="StatusValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#222222" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,32,28"
                    MaxWidth="720"
                    HorizontalAlignment="Left">

            <!-- Page heading -->
            <TextBlock Text="?!晃晃!??!跳跳!?"
                       Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding DataDir}"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap" />

            <!-- Global switch -->
            <CheckBox Content="插件激活 (全局开关 关闭 = 干净的原生游戏)"
                      Foreground="Black"
                      IsChecked="{Binding PluginActive}"
                      Margin="0,14,0,0" />

            <!-- Current status -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="当前状态"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="30" />
                            <RowDefinition MinHeight="30" />
                            <RowDefinition MinHeight="30" />
                            <RowDefinition MinHeight="30" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="游戏状态"
                                   Style="{StaticResource FieldLabel}" />
                        <Border Grid.Row="0" Grid.Column="1"
                                Background="{StaticResource SoftFillBrush}"
                                CornerRadius="5"
                                Padding="8,4"
                                Margin="0,2">
                            <TextBlock Text="{Binding GameState}"
                                       Style="{StaticResource StatusValueStyle}" />
                        </Border>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="插件状态"
                                   Style="{StaticResource FieldLabel}" />
                        <Border Grid.Row="1" Grid.Column="1"
                                Background="{StaticResource SoftFillBrush}"
                                CornerRadius="5"
                                Padding="8,4"
                                Margin="0,2">
                            <TextBlock Text="{Binding PluginState}"
                                       Style="{StaticResource StatusValueStyle}" />
                        </Border>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="当前主控角色"
                                   Style="{StaticResource FieldLabel}" />
                        <Border Grid.Row="2" Grid.Column="1"
                                Background="{StaticResource SoftFillBrush}"
                                CornerRadius="5"
                                Padding="8,4"
                                Margin="0,2">
                            <TextBlock Text="{Binding Character}"
                                       Style="{StaticResource StatusValueStyle}" />
                        </Border>

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="预设"
                                   Style="{StaticResource FieldLabel}" />
                        <Border Grid.Row="3" Grid.Column="1"
                                Background="{StaticResource SoftFillBrush}"
                                CornerRadius="5"
                                Padding="8,4"
                                Margin="0,2">
                            <TextBlock Text="{Binding Preset}"
                                       Style="{StaticResource StatusValueStyle}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Character motion controls -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <CheckBox Content="对该角色启用插件"
                              Foreground="Black"
                              IsEnabled="{Binding HasCurrent}"
                              IsChecked="{Binding Current.Enabled}" />

                    <Border Background="#F2F6FA"
                            BorderBrush="#DCE6EF"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,7"
                            Margin="0,10,0,0"
                            Visibility="{Binding HasCurrent, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="ⓘ  Start the game to edit the current character"
                                   Foreground="#65717C"
                                   FontSize="11" />
                    </Border>

                    <Grid Margin="0,12,0,0"
                          IsEnabled="{Binding HasCurrent}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="模式"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1"
                                  Height="30"
                                  SelectedIndex="{Binding Current.ModeIndex}">
                            <ComboBoxItem Content="Original (off)" />
                            <ComboBoxItem Content="Synthetic" />
                            <ComboBoxItem Content="Amplify Native" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Gait -->
            <Border Style="{StaticResource CardStyle}"
                    IsEnabled="{Binding HasCurrent}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="运动数据"
                                   Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="根据喜好和当前服装调整角色的晃动幅度，不用动频率"
                                   Style="{StaticResource SectionHintStyle}" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
</Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="向上 (度)"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="向下 (度)"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Text="晃动频率 (Hz)"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="行走"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.WalkDown, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBox Grid.Row="1" Grid.Column="2"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.WalkAmp, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBox Grid.Row="1" Grid.Column="3"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.WalkFreq, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="跑动"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.RunDown, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBox Grid.Row="2" Grid.Column="2"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.RunAmp, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBox Grid.Row="2" Grid.Column="3"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.RunFreq, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="冲刺"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.SprintDown, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBox Grid.Row="3" Grid.Column="2"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.SprintAmp, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBox Grid.Row="3" Grid.Column="3"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.SprintFreq, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="挂滑索"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.ZiplineAmp, Mode=TwoWay, Converter={StaticResource DoubleToText}}"  />
                        <TextBox Grid.Row="4" Grid.Column="2"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.ZiplineDown, Mode=TwoWay, Converter={StaticResource DoubleToText}}"  />
                        <TextBox Grid.Row="4" Grid.Column="3"
                                 Height="30" Margin="4"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.ZiplineFreq, Mode=TwoWay, Converter={StaticResource DoubleToText}}"  />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Advanced -->
            <Border Style="{StaticResource CardStyle}"
                    IsEnabled="{Binding HasCurrent}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="进阶参数"
                                   Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="不用碰调好的运动轴和方向"
                                   Style="{StaticResource SectionHintStyle}" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="52" />
                            <RowDefinition Height="52" />
                            <RowDefinition Height="58" />
                            <RowDefinition Height="38" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="振幅缩放"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Height="30"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.AmpScale, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="运动轴"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  Height="30"
                                  SelectedIndex="{Binding Current.AxisIndex}">
                            <ComboBoxItem Content="Auto" />
                            <ComboBoxItem Content="X" />
                            <ComboBoxItem Content="Y" />
                            <ComboBoxItem Content="Z" />
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="方向"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  Height="30"
                                  SelectedIndex="{Binding Current.SignIndex}">
                            <ComboBoxItem Content="+" />
                            <ComboBoxItem Content="-" />
                        </ComboBox>

                        <!-- Env attack tau -->
                        <StackPanel Grid.Row="3" Grid.Column="0"
                                    VerticalAlignment="Center"
                                    ToolTip="Env attack tau — smooths amplitude across gait/state transitions, including run→walk and zipline transitions.">
                            <TextBlock Text="不同动作间过渡平滑"
                                       Style="{StaticResource AdvancedParamTitle}" />
                            <TextBlock Text="越高 = 更平滑的过渡 · 越低 = 更快的响应"
                                       Style="{StaticResource AdvancedParamHint}" />
                        </StackPanel>
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Height="30"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 ToolTip="Env attack tau"
                                 Text="{Binding Current.EnvAttack, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                        <!-- Env freq tau -->
                        <StackPanel Grid.Row="4" Grid.Column="0"
                                    VerticalAlignment="Center"
                                    ToolTip="Env freq tau — smooths changes in motion frequency.">
                            <TextBlock Text="频率变化平滑"
                                       Style="{StaticResource AdvancedParamTitle}" />
                            <TextBlock Text="越高 = 更平滑的频率变化 · 越低 = 更快的响应"
                                       Style="{StaticResource AdvancedParamHint}" />
                        </StackPanel>
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Height="30"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 ToolTip="Env freq tau"
                                 Text="{Binding Current.EnvFreq, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                        <!-- Env to-idle tau -->
                        <StackPanel Grid.Row="5" Grid.Column="0"
                                    VerticalAlignment="Center"
                                    ToolTip="Env to-idle tau — dedicated stop/tail smoothing. Triggered when the clip name contains &quot;stop&quot; or &quot;_to_idle&quot;.">
                            <TextBlock Text="从运动到静止的平滑"
                                       Style="{StaticResource AdvancedParamTitle}" />
                            <TextBlock Text="越高 = 更平滑的过渡，停止更慢 · 越低 = 更快的停止"
                                       Style="{StaticResource AdvancedParamHint}" />
                        </StackPanel>
                        <TextBox Grid.Row="5" Grid.Column="1"
                                 Height="30"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 ToolTip="Env to-idle tau — clips containing &quot;stop&quot; or &quot;_to_idle&quot;"
                                 Text="{Binding Current.EnvIdle, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />

                        <TextBlock Grid.Row="6" Grid.Column="0"
                                   Text="原生增益"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="6" Grid.Column="1"
                                 Height="30"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 Text="{Binding Current.NativeFactor, Mode=TwoWay, Converter={StaticResource DoubleToText}}" />
                    </Grid>

                    <CheckBox Content="启用跳跃 (Jump) 功能（未完成）"
                              Margin="0,12,0,0"
                              Foreground="Black"
                              IsChecked="{Binding Current.JumpEnabled}" />
                </StackPanel>
            </Border>

            <!-- Apply -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="应用"
                        Width="140"
                        Height="32"
                        Command="{Binding ApplyCommand}" />
                <TextBlock Text="{Binding ApplyMessage}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
