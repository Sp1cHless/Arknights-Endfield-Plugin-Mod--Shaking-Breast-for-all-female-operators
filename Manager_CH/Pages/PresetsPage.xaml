<Page x:Class="SecondaryMotion.Manager.Pages.PresetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="预设" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <StackPanel Margin="24,16" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="预设" Style="{StaticResource PageTitle}" />

        <TextBlock Text="选择 - Default是根据我的游戏设置的偏好-请根据需要进行调整" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
        <ComboBox Width="260" ItemsSource="{Binding Presets}" SelectedItem="{Binding Selected}" />

        <WrapPanel Margin="0,16,0,0">
            <Button Content="应用" Width="100" Command="{Binding ApplyCommand}" />
            <Button Content="新建" Width="90" Margin="8,0,0,0" Command="{Binding NewCommand}" />
            <Button Content="复制" Width="90" Margin="8,0,0,0" Command="{Binding DuplicateCommand}" />
            <Button Content="重命名" Width="90" Margin="8,0,0,0" Command="{Binding RenameCommand}" />
            <Button Content="删除" Width="90" Margin="8,0,0,0" Command="{Binding DeleteCommand}" />
            <Button Content="导入" Width="90" Margin="8,8,0,0" Command="{Binding ImportCommand}" />
            <Button Content="导出" Width="90" Margin="8,8,0,0" Command="{Binding ExportCommand}" />
            <Button Content="重置" Width="90" Margin="8,8,0,0" Command="{Binding ResetCommand}" />
        </WrapPanel>

        <TextBlock Text="{Binding ApplyMessage}" Margin="0,16,0,0"
                   Foreground="{StaticResource AccentBrush}" />
    </StackPanel>
</Page>
