<Window x:Class="SecondaryMotion.Manager.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding TitleText}" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16" Width="320">
        <TextBlock Text="{Binding PromptText}" Margin="0,0,0,8" />
        <TextBox x:Name="Input" Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="{DynamicResource Msg_Ok}" Appearance="Primary" Width="80" Click="Ok_Click" />
            <ui:Button Content="{DynamicResource Msg_Cancel}" Width="80" Margin="8,0,0,0" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
