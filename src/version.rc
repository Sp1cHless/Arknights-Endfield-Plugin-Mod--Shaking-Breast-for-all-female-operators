#include <winver.h>

#define SM_VERSION_MAJOR 1
#define SM_VERSION_MINOR 0
#define SM_VERSION_PATCH 0
#define SM_STRINGIFY2(x) #x
#define SM_STRINGIFY(x) SM_STRINGIFY2(x)
#define SM_VERSION SM_STRINGIFY(SM_VERSION_MAJOR) "." SM_STRINGIFY(SM_VERSION_MINOR) "." SM_STRINGIFY(SM_VERSION_PATCH)

VS_VERSION_INFO VERSIONINFO
FILEVERSION SM_VERSION_MAJOR,SM_VERSION_MINOR,SM_VERSION_PATCH,0
PRODUCTVERSION SM_VERSION_MAJOR,SM_VERSION_MINOR,SM_VERSION_PATCH,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS__WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Endfield Secondary Motion Tool v1"
            VALUE "FileVersion", SM_VERSION ".0"
            VALUE "InternalName", "sbm"
            VALUE "OriginalFilename", "sbm.dll"
            VALUE "ProductName", "SecondaryMotion"
            VALUE "ProductVersion", SM_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
